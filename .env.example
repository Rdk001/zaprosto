DATABASE_URL=postgresql://zaprosto:zaprosto_local_only@localhost:5432/zaprosto?schema=public
POSTGRES_DB=zaprosto
POSTGRES_USER=zaprosto
POSTGRES_PASSWORD=zaprosto_local_only
PORT=3000
HOSTNAME=0.0.0.0

# Exact browser origin, no trailing slash; required for public/admin actions
# Admin auth: HTTPS outside loopback; see docs/admin-auth.md
PUBLIC_ORIGIN=http://localhost:3000
# Enable only behind a trusted, locked-down proxy (see docs/public-booking.md)
TRUST_PROXY_CLIENT_IP=false

# Telegram is disabled while both required values stay unset.
# Keep the username without @. Never commit a real bot token.
# TELEGRAM_BOT_TOKEN=replace-with-bot-token
# TELEGRAM_BOT_USERNAME=replace_with_bot_username
# Optional long-poll timeout: integer seconds from 5 to 50 (default: 30).
# TELEGRAM_POLL_TIMEOUT_SECONDS=30
