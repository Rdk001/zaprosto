# Copy to a protected file outside version control and replace every placeholder.
ZAPROSTO_IMAGE=zaprosto:replace-with-release-revision

POSTGRES_DB=zaprosto
POSTGRES_USER=zaprosto
POSTGRES_PASSWORD_FILE=./secrets/postgres_password

# These two values describe the same public HTTPS endpoint. PUBLIC_ORIGIN must
# include the scheme and any non-standard port, with no trailing slash.
CADDY_SITE_ADDRESS=booking.example.com
PUBLIC_ORIGIN=https://booking.example.com

# Keep the username without @. The token itself belongs only in the file below.
TELEGRAM_BOT_USERNAME=replace_with_bot_username
TELEGRAM_BOT_TOKEN_FILE=./secrets/telegram_bot_token
TELEGRAM_POLL_TIMEOUT_SECONDS=30

HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_BIND_ADDRESS=0.0.0.0
HTTPS_PORT=443
